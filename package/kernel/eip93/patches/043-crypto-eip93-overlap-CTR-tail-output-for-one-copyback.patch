From e85323cd89157db83d10b06fea9a96fc34031764 Mon Sep 17 00:00:00 2001
From: Qingfang Deng <dqfext@gmail.com>
Date: Wed, 18 Nov 2026 20:41:16 +0800
Subject: [PATCH] crypto: eip93 - overlap CTR tail output for one copyback

The opt-in multi-entry CTR path gives every descriptor a separate
padded output slot. Completion consequently restarts the destination
SG walk for every chunk, even though the caller needs one contiguous
logical result.

Write each chunk at its logical offset instead. Sequential packet
output writes allow a later descriptor to replace the extra bytes
generated by an earlier descriptor's source overread. The ADSP-
SC58x/ADSP-2158x hardware reference describes output writes finishing
before the result descriptor (page 44-27), then advancing to the next
command (page 44-36).

Retain independent counter states so overread bytes cannot advance the
next chunk's logical counter. Fill all software boundary spans after
DMA unmapping and before copying anything to potentially aliased
caller SGs. Copy back the logical length with one
sg_copy_from_buffer() call.

Size the private output by the furthest logical end plus overread,
including when a hardware chunk is followed only by a short software
tail. Remove per-chunk output gaps and report this output extent in
the DMA trace. The source SG and mapping, descriptor read lengths and
default-off policy are unchanged. Airoha hardware still needs
validation of overlapping writes.

Signed-off-by: Qingfang Deng <dqfext@gmail.com>
---
 eip93-common.c | 39 +++++++++++++++------------------------
 1 file changed, 15 insertions(+), 24 deletions(-)

diff --git a/eip93-common.c b/eip93-common.c
index d1c4473..b25c1fc 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -705,7 +705,6 @@ struct eip93_ctr_chunk {
 	struct sa_state state;
 	dma_addr_t src;
 	u32 logical;
-	u32 output;
 	u32 len;
 	u32 tail;
 	bool software;
@@ -749,7 +748,7 @@ static int eip93_plan_ctr_sg(struct eip93_cipher_reqctx *rctx, const u8 *iv,
 
 		while (available) {
 			u8 counter[AES_BLOCK_SIZE];
-			u32 len = min(available, max_len), tail, stride;
+			u32 len = min(available, max_len), tail, end;
 			u32 skip = logical & (AES_BLOCK_SIZE - 1);
 			bool software = false;
 			u64 until_wrap;
@@ -770,16 +769,12 @@ static int eip93_plan_ctr_sg(struct eip93_cipher_reqctx *rctx, const u8 *iv,
 					len = round_down(len, AES_BLOCK_SIZE);
 			}
 			tail = software ? 0 : -(addr + len) & 3;
-			stride = ALIGN(len + tail, AES_BLOCK_SIZE);
 			if (software && last_software) {
 				u32 span;
 
 				/* One CPU span can cross several small source entries. */
-				if (check_add_overflow(last_len, len, &span) ||
-				    span > U32_MAX - (AES_BLOCK_SIZE - 1))
+				if (check_add_overflow(last_len, len, &span))
 					return -EOVERFLOW;
-				stride = ALIGN(span, AES_BLOCK_SIZE) -
-					 ALIGN(last_len, AES_BLOCK_SIZE);
 				if (plan->chunks)
 					plan->chunks[count - 1].len = span;
 				last_len = span;
@@ -793,7 +788,6 @@ static int eip93_plan_ctr_sg(struct eip93_cipher_reqctx *rctx, const u8 *iv,
 					memcpy(chunk->state.state_iv, counter, sizeof(counter));
 					chunk->src = addr;
 					chunk->logical = logical;
-					chunk->output = output;
 					chunk->len = len;
 					chunk->tail = tail;
 					chunk->software = software;
@@ -801,9 +795,11 @@ static int eip93_plan_ctr_sg(struct eip93_cipher_reqctx *rctx, const u8 *iv,
 				count++;
 				last_len = len;
 			}
-			if (check_add_overflow(output, stride, &output) ||
+			/* Include overread output even if only a short CPU tail follows. */
+			if (check_add_overflow(logical + len, tail, &end) ||
 			    (!software && check_add_overflow(processed, len + tail, &processed)))
 				return -EOVERFLOW;
+			output = max(output, end);
 			if (software)
 				sw_bytes += len;
 			else
@@ -847,7 +843,7 @@ static int eip93_ctr_sg_software(struct skcipher_request *req)
 	for (i = 0; i < plan->count; i++) {
 		const struct eip93_ctr_chunk *chunk = &plan->chunks[i];
 		u32 left = chunk->len, offset = chunk->logical & (AES_BLOCK_SIZE - 1);
-		u8 *dst = sg_virt(rctx->sg_dst) + chunk->output;
+		u8 *dst = sg_virt(rctx->sg_dst) + chunk->logical;
 
 		if (!chunk->software)
 			continue;
@@ -938,10 +934,10 @@ static int eip93_send_ctr_sg(struct crypto_async_request *async, const u8 *reqiv
 	left = plan->hw_count;
 	if (debug)
 		dev_info(eip93->dev,
-			 "skcipher CTR SG: id=%d flags=%#x text=%u process=%u tail=%u sw_bytes=%u src_copy=0 dst_copy=1 src_nents=%d mapped=%d descriptors=%u dma_cfg=%#x thresholds=%#x\n",
+			 "skcipher CTR SG: id=%d flags=%#x text=%u process=%u tail=%u sw_bytes=%u output=%u src_copy=0 dst_copy=1 src_nents=%d mapped=%d descriptors=%u dma_cfg=%#x thresholds=%#x\n",
 			 rctx->request_id, rctx->flags, rctx->textsize, plan->processed,
 			 plan->processed - (rctx->textsize - plan->sw_bytes), plan->sw_bytes,
-			 rctx->src_nents, mapped, left,
+			 plan->output_len, rctx->src_nents, mapped, left,
 			 readl(eip93->base + EIP93_REG_PE_DMA_CONFIG),
 			 readl(eip93->base + EIP93_REG_PE_BUF_THRESH));
 	if (!left)
@@ -969,6 +965,9 @@ static int eip93_send_ctr_sg(struct crypto_async_request *async, const u8 *reqiv
 	desc.pe_ctrl_stat_word = FIELD_PREP(EIP93_PE_CTRL_PE_READY_DES_TRING_OWN,
 					    EIP93_PE_CTRL_HOST_READY);
 	desc.sa_addr = rctx->sa_record_base;
+	/* Ordered packet writes let the next chunk replace the preceding tail.
+	 * CPU boundary spans are filled only after every hardware write finishes.
+	 */
 	for (i = 0; i < count; i++) {
 		const struct eip93_ctr_chunk *chunk = &plan->chunks[i];
 		bool last;
@@ -978,7 +977,7 @@ static int eip93_send_ctr_sg(struct crypto_async_request *async, const u8 *reqiv
 		last = !--left;
 
 		desc.src_addr = chunk->src;
-		desc.dst_addr = sg_dma_address(rctx->sg_dst) + chunk->output;
+		desc.dst_addr = sg_dma_address(rctx->sg_dst) + chunk->logical;
 		desc.state_addr = plan->dma + i * sizeof(*chunk);
 		desc.user_id = FIELD_PREP(EIP93_PE_USER_ID_CRYPTO_IDR, rctx->request_id) |
 			FIELD_PREP(EIP93_PE_USER_ID_DESC_FLAGS,
@@ -1024,7 +1023,6 @@ int eip93_complete_ctr_sg(struct eip93_device *eip93,
 {
 	struct eip93_cipher_reqctx *rctx = skcipher_request_ctx(req);
 	struct eip93_ctr_plan *plan = rctx->ctr_plan;
-	u32 i;
 
 	dma_unmap_sg(eip93->dev, rctx->sg_src, rctx->src_nents, DMA_TO_DEVICE);
 	if (plan->hw_count) {
@@ -1037,16 +1035,9 @@ int eip93_complete_ctr_sg(struct eip93_device *eip93,
 	if (!err)
 		err = eip93_ctr_sg_software(req);
 	if (!err) {
-		for (i = 0; i < plan->count; i++) {
-			const struct eip93_ctr_chunk *chunk = &plan->chunks[i];
-
-			if (sg_pcopy_from_buffer(req->dst, sg_nents(req->dst),
-						 sg_virt(rctx->sg_dst) + chunk->output,
-						 chunk->len, chunk->logical) != chunk->len) {
-				err = -EINVAL;
-				break;
-			}
-		}
+		if (sg_copy_from_buffer(req->dst, sg_nents(req->dst),
+					sg_virt(rctx->sg_dst), rctx->textsize) != rctx->textsize)
+			err = -EINVAL;
 		if (!err && !IS_RFC3686(rctx->flags))
 			memcpy(req->iv, rctx->tail_iv, AES_BLOCK_SIZE);
 	}
-- 
2.52.0

