From b0521e4f0d7efc3362dd0fa4fb189652bb71722b Mon Sep 17 00:00:00 2001
From: LGA1150 <9155358+LGA1150@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:27:00 +0800
Subject: [PATCH] crypto: eip93 - add opt-in authenc DMA boundary diagnostics

Airoha authenc failures in cases 281 and 323 affect bytes near the end of
the packet. Both requests use page-aligned bounce buffers, so changing
the caller's SG offset does not vary the address used by the engine.
Case 323 is intermittent and a later full run on release 16 passed.

Add independently selectable source and destination bounce offsets,
restricted to word- and cache-line-aligned values within the first page.
Allocate the offset plus the padded mapping and free using the stored SG
allocation geometry, including after a parameter change or error.
Nonzero offsets force the corresponding authenc buffer to bounce.

Add opt-in logs for mapped DMA addresses, lengths, bounce use, SA/state
addresses, DMA configuration and every authenc completion. A separate
diagnostic switch bypasses only the partial-output-word fallback so the
physical failure can be investigated. Defaults retain the existing
alignment checks, fallback and buffer placement. No register is changed.

The DMA configuration register is at offset 0x120 in the SHARC+ hardware
reference, table A-105; table 44-43 defines MXBRSTSZ in bits 3:0.

Host GCC W=1 builds the module. QEMU tests exercise actual allocation,
cleanup and AEAD helpers with software crypto, shifted bounce buffers,
boundary lengths and injected preparation/completion failures. They do
not emulate EIP93 DMA or establish the physical fault's cause.

Signed-off-by: LGA1150 <9155358+LGA1150@users.noreply.github.com>
---
 eip93-aead.c   |  7 ++++-
 eip93-common.c | 80 +++++++++++++++++++++++++++++++++++++++++++++-----
 eip93-common.h |  2 ++
 eip93-regs.h   |  2 ++
 4 files changed, 83 insertions(+), 8 deletions(-)

diff --git a/eip93-aead.c b/eip93-aead.c
index b1978c6..20c4541 100644
--- a/eip93-aead.c
+++ b/eip93-aead.c
@@ -37,6 +37,10 @@ void eip93_aead_handle_result(struct crypto_async_request *async, int err,
 	int hw_err = err;
 
 	err = eip93_unmap_dma(eip93, rctx, req->src, req->dst, err);
+	if (READ_ONCE(eip93_aead_dma_debug))
+		dev_info(eip93->dev,
+			 "authenc done: id=%d ctrl=%#x len=%#x hw_err=%d err=%d\n",
+			 rctx->request_id, ctrl, length, hw_err, err);
 	if (err && READ_ONCE(eip93_aead_debug))
 		dev_info(eip93->dev,
 			 "authenc %s error: id=%d ctrl=%#x len=%#x hw_err=%d err=%d\n",
@@ -245,7 +249,8 @@ static bool eip93_aead_needs_fallback(struct aead_request *req,
 		return true;
 
 	/* A partial output word can repeat its last byte on Airoha. */
-	if (!IS_ALIGNED(req->assoclen + textsize, sizeof(u32)))
+	if (!IS_ALIGNED(req->assoclen + textsize, sizeof(u32)) &&
+	    !READ_ONCE(eip93_aead_allow_partial))
 		return true;
 
 	if (IS_ALIGNED(req->assoclen, sizeof(u32)))
diff --git a/eip93-common.c b/eip93-common.c
index e724ac5..518c4ea 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -15,6 +15,7 @@
 #include <linux/kernel.h>
 #include <linux/dma-mapping.h>
 #include <linux/moduleparam.h>
+#include <linux/overflow.h>
 #include <linux/scatterlist.h>
 #include <linux/unaligned.h>
 
@@ -28,6 +29,43 @@ bool eip93_aead_debug;
 module_param_named(aead_debug, eip93_aead_debug, bool, 0600);
 MODULE_PARM_DESC(aead_debug, "Log authenc completion status and tag mismatch byte masks");
 
+bool eip93_aead_dma_debug;
+module_param_named(aead_dma_debug, eip93_aead_dma_debug, bool, 0600);
+MODULE_PARM_DESC(aead_dma_debug, "Log authenc DMA addresses, lengths and all completions");
+
+bool eip93_aead_allow_partial;
+module_param_named(aead_allow_partial, eip93_aead_allow_partial, bool, 0600);
+MODULE_PARM_DESC(aead_allow_partial, "Diagnostic only: allow unreliable partial-word authenc DMA output");
+
+static unsigned int aead_src_offset;
+static unsigned int aead_dst_offset;
+
+static int eip93_offset_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int offset;
+	int err;
+
+	err = kstrtouint(val, 0, &offset);
+	if (err)
+		return err;
+	if (offset >= PAGE_SIZE || !IS_ALIGNED(offset, sizeof(u32)) ||
+	    !IS_ALIGNED(offset, dma_get_cache_alignment()))
+		return -EINVAL;
+
+	WRITE_ONCE(*(unsigned int *)kp->arg, offset);
+	return 0;
+}
+
+static const struct kernel_param_ops eip93_offset_ops = {
+	.set = eip93_offset_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(aead_src_offset, &eip93_offset_ops, &aead_src_offset, 0600);
+MODULE_PARM_DESC(aead_src_offset, "Authenc source bounce offset: cache-line multiple below PAGE_SIZE");
+module_param_cb(aead_dst_offset, &eip93_offset_ops, &aead_dst_offset, 0600);
+MODULE_PARM_DESC(aead_dst_offset, "Authenc destination bounce offset: cache-line multiple below PAGE_SIZE");
+
 int eip93_alloc_req_id(struct eip93_device *eip93,
 		       struct crypto_async_request *async)
 {
@@ -180,22 +218,30 @@ static void eip93_free_sg_copy(const int len, struct scatterlist **sg)
 	if (!*sg || !len)
 		return;
 
-	free_pages((unsigned long)sg_virt(*sg), get_order(len));
+	/* Diagnostic offsets stay within the allocation's first page. */
+	free_pages((unsigned long)page_address(sg_page(*sg)),
+		   get_order((unsigned long)(*sg)->offset + (*sg)->length));
 	kfree(*sg);
 	*sg = NULL;
 }
 
 static int eip93_make_sg_copy(struct scatterlist *src, struct scatterlist **dst,
-			      const u32 len, const bool copy)
+			      const u32 len, const bool copy, unsigned int offset)
 {
+	unsigned long map_len = ALIGN((unsigned long)len, dma_get_cache_alignment());
+	unsigned long alloc_len;
 	void *pages;
 
+	if (map_len < len || map_len > UINT_MAX ||
+	    check_add_overflow(map_len, (unsigned long)offset, &alloc_len))
+		return -EOVERFLOW;
+
 	*dst = kmalloc(sizeof(**dst), GFP_KERNEL);
 	if (!*dst)
 		return -ENOMEM;
 
 	pages = (void *)__get_free_pages(GFP_KERNEL | GFP_DMA,
-					 get_order(len));
+					 get_order(alloc_len));
 	if (!pages) {
 		kfree(*dst);
 		*dst = NULL;
@@ -204,11 +250,11 @@ static int eip93_make_sg_copy(struct scatterlist *src, struct scatterlist **dst,
 
 	sg_init_table(*dst, 1);
 	/* The page allocation owns the padding through the last cache line. */
-	sg_set_buf(*dst, pages, ALIGN(len, dma_get_cache_alignment()));
+	sg_set_buf(*dst, pages + offset, map_len);
 
 	/* copy only as requested */
 	if (copy)
-		sg_copy_to_buffer(src, sg_nents(src), pages, len);
+		sg_copy_to_buffer(src, sg_nents(src), pages + offset, len);
 
 	return 0;
 }
@@ -258,6 +304,7 @@ static int check_valid_request(struct eip93_cipher_reqctx *rctx)
 	u32 totlen_src = rctx->assoclen + rctx->textsize;
 	u32 totlen_dst = rctx->assoclen + rctx->textsize;
 	u32 copy_len;
+	unsigned int src_offset = 0, dst_offset = 0;
 	bool src_align, dst_align;
 	int src_nents, dst_nents;
 	int err = -EINVAL;
@@ -321,15 +368,24 @@ static int check_valid_request(struct eip93_cipher_reqctx *rctx)
 	if (authsize && IS_DECRYPT(rctx->flags))
 		dst_align = false;
 
+	if (authsize) {
+		src_offset = READ_ONCE(aead_src_offset);
+		dst_offset = READ_ONCE(aead_dst_offset);
+		if (src_offset)
+			src_align = false;
+		if (dst_offset)
+			dst_align = false;
+	}
+
 	copy_len = max(totlen_src, totlen_dst);
 	if (!src_align) {
-		err = eip93_make_sg_copy(src, &rctx->sg_src, copy_len, true);
+		err = eip93_make_sg_copy(src, &rctx->sg_src, copy_len, true, src_offset);
 		if (err)
 			return err;
 	}
 
 	if (!dst_align) {
-		err = eip93_make_sg_copy(dst, &rctx->sg_dst, copy_len, false);
+		err = eip93_make_sg_copy(dst, &rctx->sg_dst, copy_len, false, dst_offset);
 		if (err)
 			return err;
 	}
@@ -693,6 +749,16 @@ skip_iv:
 		goto unmap_sg_dst;
 	}
 
+	if (rctx->authsize && READ_ONCE(eip93_aead_dma_debug))
+		dev_info(eip93->dev,
+			 "authenc DMA: id=%d flags=%#x text=%u aad=%u tag=%u process=%u src=%pad dst=%pad src_map=%u dst_map=%u src_copy=%d dst_copy=%d src_off=%u dst_off=%u sa=%pad state=%pad dma_cfg=%#x\n",
+			 rctx->request_id, flags, rctx->textsize, rctx->assoclen,
+			 rctx->authsize, datalen, &sg_dma_address(src),
+			 &sg_dma_address(dst), sg_dma_len(src), sg_dma_len(dst),
+			 src != reqsrc, dst != reqdst, src->offset, dst->offset,
+			 &rctx->sa_record_base, &rctx->sa_state_base,
+			 readl(eip93->base + EIP93_REG_PE_DMA_CONFIG));
+
 	return eip93_scatter_combine(eip93, rctx, datalen, split, offsetin);
 
 unmap_sg_dst:
diff --git a/eip93-common.h b/eip93-common.h
index 0da4726..0216cc4 100644
--- a/eip93-common.h
+++ b/eip93-common.h
@@ -10,6 +10,8 @@
 #define _EIP93_COMMON_H_
 
 extern bool eip93_aead_debug;
+extern bool eip93_aead_dma_debug;
+extern bool eip93_aead_allow_partial;
 
 int eip93_alloc_req_id(struct eip93_device *eip93,
 		       struct crypto_async_request *async);
diff --git a/eip93-regs.h b/eip93-regs.h
index 1944368..270d7b4 100644
--- a/eip93-regs.h
+++ b/eip93-regs.h
@@ -112,6 +112,8 @@
 #define EIP93_REG_PE_INBUF_COUNT		0x110
 #define EIP93_REG_PE_OUTBUF_COUNT		0x114
 #define EIP93_REG_PE_BUF_RW_PNTR		0x118 /* BUF_PNTR */
+#define EIP93_REG_PE_DMA_CONFIG			0x120
+#define   EIP93_PE_DMA_MAX_BURST			GENMASK(3, 0)
 
 /* PACKET ENGINE endian config */
 #define EIP93_REG_PE_ENDIAN_CONFIG		0x1cc
