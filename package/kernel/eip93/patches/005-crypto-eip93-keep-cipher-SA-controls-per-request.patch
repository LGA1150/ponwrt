From 869f476d12413a006bc32a79d6367bca2bac494f Mon Sep 17 00:00:00 2001
From: LGA1150 <9155358+LGA1150@users.noreply.github.com>
Date: Tue, 17 Nov 2026 11:24:50 +0800
Subject: [PATCH 2/6] crypto: eip93 - keep cipher SA controls per request

Use a private SA record for each in-flight cipher operation. Direction
and AAD offset belong to the request, so preparing a decrypt must not
alter the SA of an earlier encryption or a queued request on the same
transform. Free the private record with its request mapping.

Signed-off-by: LGA1150 <9155358+LGA1150@users.noreply.github.com>
---
 eip93-aead.c   | 36 ------------------------------------
 eip93-cipher.c |  3 ---
 eip93-cipher.h |  3 +--
 eip93-common.c | 27 ++++++++++++++++++++++++---
 4 files changed, 25 insertions(+), 44 deletions(-)

diff --git a/eip93-aead.c b/eip93-aead.c
index 409f8ee..1910e42 100644
--- a/eip93-aead.c
+++ b/eip93-aead.c
@@ -53,7 +53,6 @@ static int eip93_aead_cra_init(struct crypto_tfm *tfm)
 	ctx->eip93 = tmpl->eip93;
 	ctx->flags = tmpl->flags;
 	ctx->type = tmpl->type;
-	ctx->set_assoc = true;
 
 	ctx->sa_record = kzalloc(sizeof(*ctx->sa_record), GFP_KERNEL);
 	if (!ctx->sa_record)
@@ -135,7 +134,6 @@ static int eip93_aead_setkey(struct crypto_aead *ctfm, const u8 *key,
 				ctx->authsize, sa_record->sa_i_digest,
 				sa_record->sa_o_digest, false);
 
-	ctx->set_assoc = true;
 
 	return ret;
 }
@@ -154,18 +152,6 @@ static int eip93_aead_setauthsize(struct crypto_aead *ctfm,
 	return 0;
 }
 
-static void eip93_aead_setassoc(struct eip93_crypto_ctx *ctx,
-				struct aead_request *req)
-{
-	struct sa_record *sa_record = ctx->sa_record;
-
-	sa_record->sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
-	sa_record->sa_cmd1_word |= FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
-					      req->assoclen / sizeof(u32));
-
-	ctx->assoclen = req->assoclen;
-}
-
 static int eip93_aead_crypt(struct aead_request *req)
 {
 	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
@@ -208,15 +194,6 @@ static int eip93_aead_encrypt(struct aead_request *req)
 
 	rctx->flags = ctx->flags;
 	rctx->flags |= EIP93_ENCRYPT;
-	if (ctx->set_assoc) {
-		eip93_aead_setassoc(ctx, req);
-		ctx->set_assoc = false;
-	}
-
-	if (req->assoclen != ctx->assoclen) {
-		dev_err(ctx->eip93->dev, "Request AAD length error\n");
-		return -EINVAL;
-	}
 
 	return eip93_aead_crypt(req);
 }
@@ -226,21 +203,8 @@ static int eip93_aead_decrypt(struct aead_request *req)
 	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
 	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
 
-	ctx->sa_record->sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
-	ctx->sa_record->sa_cmd1_word &= ~(EIP93_SA_CMD_COPY_PAD |
-					  EIP93_SA_CMD_COPY_DIGEST);
-
 	rctx->flags = ctx->flags;
 	rctx->flags |= EIP93_DECRYPT;
-	if (ctx->set_assoc) {
-		eip93_aead_setassoc(ctx, req);
-		ctx->set_assoc = false;
-	}
-
-	if (req->assoclen != ctx->assoclen) {
-		dev_err(ctx->eip93->dev, "Request AAD length error\n");
-		return -EINVAL;
-	}
 
 	return eip93_aead_crypt(req);
 }
diff --git a/eip93-cipher.c b/eip93-cipher.c
index b3970f1..cea6fc1 100644
--- a/eip93-cipher.c
+++ b/eip93-cipher.c
@@ -215,13 +215,10 @@ static int eip93_skcipher_encrypt(struct skcipher_request *req)
 
 static int eip93_skcipher_decrypt(struct skcipher_request *req)
 {
-	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
 	struct eip93_cipher_reqctx *rctx = skcipher_request_ctx(req);
 	struct eip93_alg_template *tmpl = container_of(req->base.tfm->__crt_alg,
 				struct eip93_alg_template, alg.skcipher.base);
 
-	ctx->sa_record->sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
-
 	rctx->flags = tmpl->flags;
 	rctx->flags |= EIP93_DECRYPT;
 
diff --git a/eip93-cipher.h b/eip93-cipher.h
index 9521327..2c19f2e 100644
--- a/eip93-cipher.h
+++ b/eip93-cipher.h
@@ -18,8 +18,6 @@ struct eip93_crypto_ctx {
 	int				blksize;
 	/* AEAD specific */
 	unsigned int			authsize;
-	unsigned int			assoclen;
-	bool				set_assoc;
 	enum eip93_alg_type		type;
 	struct crypto_skcipher		*fallback;
 };
@@ -33,6 +31,7 @@ struct eip93_cipher_reqctx {
 	unsigned int			textsize;
 	unsigned int			assoclen;
 	unsigned int			authsize;
+	struct sa_record		*sa_record;
 	dma_addr_t			sa_record_base;
 	struct sa_state			*sa_state;
 	dma_addr_t			sa_state_base;
diff --git a/eip93-common.c b/eip93-common.c
index e757812..c49a423 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -556,12 +556,30 @@ int eip93_send_req(struct crypto_async_request *async,
 	src = rctx->sg_src;
 	dst = rctx->sg_dst;
 
-	rctx->sa_record_base = dma_map_single(eip93->dev, ctx->sa_record,
-					      sizeof(*ctx->sa_record), DMA_TO_DEVICE);
-	if (dma_mapping_error(eip93->dev, rctx->sa_record_base)) {
+	rctx->sa_record = kmemdup(ctx->sa_record, sizeof(*ctx->sa_record),
+				  GFP_KERNEL);
+	if (!rctx->sa_record) {
 		err = -ENOMEM;
 		goto free_sg_copy;
 	}
+	if (IS_DECRYPT(flags))
+		rctx->sa_record->sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
+	if (IS_HMAC(flags)) {
+		rctx->sa_record->sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
+		rctx->sa_record->sa_cmd1_word |=
+			FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
+				   rctx->assoclen / sizeof(u32));
+		if (IS_DECRYPT(flags))
+			rctx->sa_record->sa_cmd1_word &= ~(EIP93_SA_CMD_COPY_PAD |
+							 EIP93_SA_CMD_COPY_DIGEST);
+	}
+
+	rctx->sa_record_base = dma_map_single(eip93->dev, rctx->sa_record,
+					      sizeof(*rctx->sa_record), DMA_TO_DEVICE);
+	if (dma_mapping_error(eip93->dev, rctx->sa_record_base)) {
+		err = -ENOMEM;
+		goto free_sa_record;
+	}
 
 	if (IS_ECB(flags))
 		goto skip_iv;
@@ -670,6 +688,8 @@ free_sa_state:
 unmap_sa_record:
 	dma_unmap_single(eip93->dev, rctx->sa_record_base,
 			 sizeof(*ctx->sa_record), DMA_TO_DEVICE);
+free_sa_record:
+	kfree(rctx->sa_record);
 free_sg_copy:
 	/* No descriptor was submitted: discard bounce buffers without copyback. */
 	if (rctx->sg_src != reqsrc)
@@ -729,6 +749,7 @@ void eip93_handle_result(struct eip93_device *eip93, struct eip93_cipher_reqctx
 {
 	dma_unmap_single(eip93->dev, rctx->sa_record_base,
 			 sizeof(struct sa_record), DMA_TO_DEVICE);
+	kfree(rctx->sa_record);
 
 	if (rctx->sa_state_ctr)
 		dma_unmap_single(eip93->dev, rctx->sa_state_ctr_base,
