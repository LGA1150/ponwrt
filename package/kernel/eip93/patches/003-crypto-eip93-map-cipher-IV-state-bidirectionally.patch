From 6e2f7f3d8cc88eb8804b36f81994cb02ffd3eca9 Mon Sep 17 00:00:00 2001
From: Qingfang Deng <dqfext@gmail.com>
Date: Tue, 17 Nov 2026 10:15:37 +0800
Subject: [PATCH] crypto: eip93 - map cipher IV state bidirectionally

The engine reads the initial IV and writes the updated state. Use
DMA_BIDIRECTIONAL for both mapping and unmapping, including the extra
state used when a CTR request crosses the low 32-bit counter boundary.

Signed-off-by: Qingfang Deng <dqfext@gmail.com>
---
 eip93-common.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/eip93-common.c b/eip93-common.c
index 24cd435..b47f091 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -590,7 +590,7 @@ int eip93_send_req(struct crypto_async_request *async,
 
 			rctx->sa_state_ctr_base = dma_map_single(eip93->dev, rctx->sa_state_ctr,
 								 sizeof(*rctx->sa_state_ctr),
-								 DMA_TO_DEVICE);
+								 DMA_BIDIRECTIONAL);
 			if (dma_mapping_error(eip93->dev, rctx->sa_state_ctr_base)) {
 				err = -ENOMEM;
 				goto free_sa_state_ctr;
@@ -599,7 +599,7 @@ int eip93_send_req(struct crypto_async_request *async,
 	}
 
 	rctx->sa_state_base = dma_map_single(eip93->dev, rctx->sa_state,
-					     sizeof(*rctx->sa_state), DMA_TO_DEVICE);
+					     sizeof(*rctx->sa_state), DMA_BIDIRECTIONAL);
 	if (dma_mapping_error(eip93->dev, rctx->sa_state_base)) {
 		err = -ENOMEM;
 		goto unmap_sa_state_ctr;
@@ -642,11 +642,11 @@ unmap_sg_dst:
 unmap_sa_state:
 	if (rctx->sa_state)
 		dma_unmap_single(eip93->dev, rctx->sa_state_base,
-				 sizeof(*rctx->sa_state), DMA_TO_DEVICE);
+				 sizeof(*rctx->sa_state), DMA_BIDIRECTIONAL);
 unmap_sa_state_ctr:
 	if (rctx->sa_state_ctr)
 		dma_unmap_single(eip93->dev, rctx->sa_state_ctr_base,
-				 sizeof(*rctx->sa_state_ctr), DMA_TO_DEVICE);
+				 sizeof(*rctx->sa_state_ctr), DMA_BIDIRECTIONAL);
 free_sa_state_ctr:
 	kfree(rctx->sa_state_ctr);
 free_sa_state:
@@ -717,12 +717,12 @@ void eip93_handle_result(struct eip93_device *eip93, struct eip93_cipher_reqctx
 	if (rctx->sa_state_ctr)
 		dma_unmap_single(eip93->dev, rctx->sa_state_ctr_base,
 				 sizeof(*rctx->sa_state_ctr),
-				 DMA_FROM_DEVICE);
+				 DMA_BIDIRECTIONAL);
 
 	if (rctx->sa_state)
 		dma_unmap_single(eip93->dev, rctx->sa_state_base,
 				 sizeof(*rctx->sa_state),
-				 DMA_FROM_DEVICE);
+				 DMA_BIDIRECTIONAL);
 
 	if (!IS_ECB(rctx->flags))
 		memcpy(reqiv, rctx->sa_state->state_iv, rctx->ivsize);
