From cc2c2625a35c71ae7e5484af7d92970da2c29280 Mon Sep 17 00:00:00 2001
From: Qingfang Deng <dqfext@gmail.com>
Date: Wed, 18 Nov 2026 01:11:27 +0800
Subject: [PATCH] crypto: eip93 - restore authenc packet tag DMA

With the lower DMA buffer thresholds in place, revert patch 021's
saved-hash-state workaround. Let the engine append the computed digest
to the packet again instead of fetching it from SA state and appending
encryption tags on the CPU.

Restore IV and CTR-wrap state unmapping to the completion cleanup. Keep
the existing host tag comparison for basic hash-decrypt, private
decryption destinations, SHA word normalization and error handling.
Decrypted plaintext is still copied back only after authentication.

The packet DMA output length now includes the tag in both directions;
the diagnostic process length continues to describe AAD plus payload.

Signed-off-by: Qingfang Deng <dqfext@gmail.com>
---
 eip93-aead.c   |  3 ---
 eip93-common.c | 28 ++++++++++++++--------------
 2 files changed, 14 insertions(+), 17 deletions(-)

diff --git a/eip93-aead.c b/eip93-aead.c
index 8f4c1aa..a68c5f2 100644
--- a/eip93-aead.c
+++ b/eip93-aead.c
@@ -152,9 +152,6 @@ static int eip93_aead_setkey(struct crypto_aead *ctfm, const u8 *key,
 	sa_record->sa_cmd0_word &= ~EIP93_SA_CMD_DIGEST_LENGTH;
 	sa_record->sa_cmd0_word |= FIELD_PREP(EIP93_SA_CMD_DIGEST_LENGTH,
 					      ctx->authsize / sizeof(u32));
-	/* Fetch the digest from aligned state, not the packet's byte tail. */
-	sa_record->sa_cmd0_word |= EIP93_SA_CMD_SAVE_HASH;
-	sa_record->sa_cmd1_word &= ~EIP93_SA_CMD_COPY_DIGEST;
 
 	memcpy(sa_record->sa_key, keys.enckey, keys.enckeylen);
 	ctx->sa_nonce = nonce;
diff --git a/eip93-common.c b/eip93-common.c
index 4f35b46..8850fc3 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -360,7 +360,7 @@ static int check_valid_request(struct eip93_cipher_reqctx *rctx)
 			dst_align = eip93_is_sg_aligned(dst, totlen_dst, blksize, true);
 	}
 
-	/* Keep the input tag and hold decrypted data until authentication. */
+	/* Basic hash-decrypt writes a digest; it does not verify the input tag. */
 	if (authsize && IS_DECRYPT(rctx->flags))
 		dst_align = false;
 
@@ -798,7 +798,7 @@ int eip93_unmap_dma(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx
 	if (rctx->sg_src == rctx->sg_dst) {
 		dma_unmap_sg(eip93->dev, rctx->sg_dst, rctx->dst_nents,
 			     DMA_BIDIRECTIONAL);
-		goto unmap_state;
+		goto process_tag;
 	}
 
 	dma_unmap_sg(eip93->dev, rctx->sg_src, rctx->src_nents,
@@ -807,16 +807,9 @@ int eip93_unmap_dma(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx
 	dma_unmap_sg(eip93->dev, rctx->sg_dst, rctx->dst_nents,
 		     DMA_BIDIRECTIONAL);
 
-unmap_state:
-	if (rctx->sa_state_ctr)
-		dma_unmap_single(eip93->dev, rctx->sa_state_ctr_base,
-				 sizeof(*rctx->sa_state_ctr), DMA_BIDIRECTIONAL);
-	if (rctx->sa_state)
-		dma_unmap_single(eip93->dev, rctx->sa_state_base,
-				 sizeof(*rctx->sa_state), DMA_BIDIRECTIONAL);
-
+process_tag:
 	if (!err && authsize) {
-		otag = rctx->sa_state->state_i_digest;
+		otag = sg_virt(rctx->sg_dst) + len;
 		/* Convert the hardware's SHA digest words to tag bytes. */
 		if (!IS_HASH_MD5(flags)) {
 			for (i = 0; i < (authsize / 4); i++)
@@ -841,9 +834,6 @@ unmap_state:
 					 rctx->sg_src != reqsrc, rctx->sg_dst != reqdst);
 			}
 		}
-		if (IS_ENCRYPT(flags))
-			sg_pcopy_from_buffer(rctx->sg_dst, rctx->dst_nents,
-					     otag, authsize, len);
 	}
 
 	if (rctx->sg_src != rctx->sg_dst && rctx->sg_src != reqsrc)
@@ -869,6 +859,16 @@ void eip93_handle_result(struct eip93_device *eip93, struct eip93_cipher_reqctx
 			 sizeof(struct sa_record), DMA_TO_DEVICE);
 	kfree(rctx->sa_record);
 
+	if (rctx->sa_state_ctr)
+		dma_unmap_single(eip93->dev, rctx->sa_state_ctr_base,
+				 sizeof(*rctx->sa_state_ctr),
+				 DMA_BIDIRECTIONAL);
+
+	if (rctx->sa_state)
+		dma_unmap_single(eip93->dev, rctx->sa_state_base,
+				 sizeof(*rctx->sa_state),
+				 DMA_BIDIRECTIONAL);
+
 	if (!IS_ECB(rctx->flags))
 		memcpy(reqiv, rctx->sa_state->state_iv, rctx->ivsize);
 
