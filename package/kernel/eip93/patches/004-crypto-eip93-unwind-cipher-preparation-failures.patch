From 74efa13e7ced1179e7199a4f1808b97b0079ffc5 Mon Sep 17 00:00:00 2001
From: Qingfang Deng <dqfext@gmail.com>
Date: Tue, 17 Nov 2026 11:24:50 +0800
Subject: [PATCH 1/6] crypto: eip93 - unwind cipher request preparation
 failures

Return preparation errors without invoking completion, discard bounce
buffers without copyback, and unwind only successful DMA mappings. Keep
the SA mapping per request and release it on completion instead of
leaking all but the final transform mapping. This allows a submission
worker to complete preparation failures exactly once.

Signed-off-by: Qingfang Deng <dqfext@gmail.com>
---
 eip93-aead.c   | 27 +--------------------
 eip93-cipher.c | 28 +---------------------
 eip93-cipher.h |  3 ---
 eip93-common.c | 65 ++++++++++++++++++++++++++++++++++++--------------
 4 files changed, 49 insertions(+), 74 deletions(-)

diff --git a/eip93-aead.c b/eip93-aead.c
index 271e7f5..409f8ee 100644
--- a/eip93-aead.c
+++ b/eip93-aead.c
@@ -40,21 +40,6 @@ void eip93_aead_handle_result(struct crypto_async_request *async, int err)
 	aead_request_complete(req, err);
 }
 
-static int eip93_aead_send_req(struct crypto_async_request *async)
-{
-	struct aead_request *req = aead_request_cast(async);
-	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
-	int err;
-
-	err = check_valid_request(rctx);
-	if (err) {
-		aead_request_complete(req, err);
-		return err;
-	}
-
-	return eip93_send_req(async, req->iv, rctx);
-}
-
 /* Crypto aead API functions */
 static int eip93_aead_cra_init(struct crypto_tfm *tfm)
 {
@@ -81,8 +66,6 @@ static void eip93_aead_cra_exit(struct crypto_tfm *tfm)
 {
 	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(tfm);
 
-	dma_unmap_single(ctx->eip93->dev, ctx->sa_record_base,
-			 sizeof(*ctx->sa_record), DMA_TO_DEVICE);
 	kfree(ctx->sa_record);
 }
 
@@ -198,12 +181,6 @@ static int eip93_aead_crypt(struct aead_request *req)
 		return request_id;
 	rctx->request_id = request_id;
 
-	ctx->sa_record_base = dma_map_single(ctx->eip93->dev, ctx->sa_record,
-					     sizeof(*ctx->sa_record), DMA_TO_DEVICE);
-	ret = dma_mapping_error(ctx->eip93->dev, ctx->sa_record_base);
-	if (ret)
-		goto free_request_id;
-
 	rctx->textsize = req->cryptlen;
 	rctx->blksize = ctx->blksize;
 	rctx->assoclen = req->assoclen;
@@ -212,16 +189,14 @@ static int eip93_aead_crypt(struct aead_request *req)
 	rctx->sg_dst = req->dst;
 	rctx->ivsize = crypto_aead_ivsize(aead);
 	rctx->desc_flags = EIP93_DESC_AEAD;
-	rctx->sa_record_base = ctx->sa_record_base;
 
 	if (IS_DECRYPT(rctx->flags))
 		rctx->textsize -= rctx->authsize;
 
-	ret = eip93_aead_send_req(async);
+	ret = eip93_send_req(async, req->iv, rctx);
 	if (ret == -EINPROGRESS)
 		return ret;
 
-free_request_id:
 	eip93_free_req_id(eip93, request_id);
 	return ret;
 }
diff --git a/eip93-cipher.c b/eip93-cipher.c
index 3f572cc..b3970f1 100644
--- a/eip93-cipher.c
+++ b/eip93-cipher.c
@@ -37,22 +37,6 @@ static inline bool eip93_skcipher_is_fallback(const struct crypto_tfm *tfm,
 		!IS_RFC3686(flags);
 }
 
-static int eip93_skcipher_send_req(struct crypto_async_request *async)
-{
-	struct skcipher_request *req = skcipher_request_cast(async);
-	struct eip93_cipher_reqctx *rctx = skcipher_request_ctx(req);
-	int err;
-
-	err = check_valid_request(rctx);
-
-	if (err) {
-		skcipher_request_complete(req, err);
-		return err;
-	}
-
-	return eip93_send_req(async, req->iv, rctx);
-}
-
 /* Crypto skcipher API functions */
 static int eip93_skcipher_cra_init(struct crypto_tfm *tfm)
 {
@@ -88,8 +72,6 @@ static void eip93_skcipher_cra_exit(struct crypto_tfm *tfm)
 {
 	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(tfm);
 
-	dma_unmap_single(ctx->eip93->dev, ctx->sa_record_base,
-			 sizeof(*ctx->sa_record), DMA_TO_DEVICE);
 	kfree(ctx->sa_record);
 
 	crypto_free_skcipher(ctx->fallback);
@@ -202,12 +184,6 @@ static int eip93_skcipher_crypt(struct skcipher_request *req, bool encrypt)
 		return request_id;
 	rctx->request_id = request_id;
 
-	ctx->sa_record_base = dma_map_single(ctx->eip93->dev, ctx->sa_record,
-					     sizeof(*ctx->sa_record), DMA_TO_DEVICE);
-	ret = dma_mapping_error(ctx->eip93->dev, ctx->sa_record_base);
-	if (ret)
-		goto free_request_id;
-
 	rctx->assoclen = 0;
 	rctx->textsize = req->cryptlen;
 	rctx->authsize = 0;
@@ -216,13 +192,11 @@ static int eip93_skcipher_crypt(struct skcipher_request *req, bool encrypt)
 	rctx->ivsize = crypto_skcipher_ivsize(skcipher);
 	rctx->blksize = ctx->blksize;
 	rctx->desc_flags = EIP93_DESC_SKCIPHER;
-	rctx->sa_record_base = ctx->sa_record_base;
 
-	ret = eip93_skcipher_send_req(async);
+	ret = eip93_send_req(async, req->iv, rctx);
 	if (ret == -EINPROGRESS)
 		return ret;
 
-free_request_id:
 	eip93_free_req_id(eip93, request_id);
 	return ret;
 }
diff --git a/eip93-cipher.h b/eip93-cipher.h
index b3a54e6..9521327 100644
--- a/eip93-cipher.h
+++ b/eip93-cipher.h
@@ -16,7 +16,6 @@ struct eip93_crypto_ctx {
 	struct sa_record		*sa_record;
 	u32				sa_nonce;
 	int				blksize;
-	dma_addr_t			sa_record_base;
 	/* AEAD specific */
 	unsigned int			authsize;
 	unsigned int			assoclen;
@@ -47,8 +46,6 @@ struct eip93_cipher_reqctx {
 	struct skcipher_request		fallback_req;
 };
 
-int check_valid_request(struct eip93_cipher_reqctx *rctx);
-
 void eip93_unmap_dma(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx,
 		     struct scatterlist *reqsrc, struct scatterlist *reqdst);
 
diff --git a/eip93-common.c b/eip93-common.c
index 1f1e551..e757812 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -220,7 +220,7 @@ static bool eip93_is_sg_aligned(struct scatterlist *sg, u32 len,
 	return false;
 }
 
-int check_valid_request(struct eip93_cipher_reqctx *rctx)
+static int check_valid_request(struct eip93_cipher_reqctx *rctx)
 {
 	struct scatterlist *src = rctx->sg_src;
 	struct scatterlist *dst = rctx->sg_dst;
@@ -537,6 +537,7 @@ int eip93_send_req(struct crypto_async_request *async,
 	struct eip93_device *eip93 = ctx->eip93;
 	struct scatterlist *src = rctx->sg_src;
 	struct scatterlist *dst = rctx->sg_dst;
+	struct scatterlist *reqsrc = src, *reqdst = dst;
 	struct sa_state *sa_state;
 	struct eip93_descriptor cdesc;
 	u32 flags = rctx->flags;
@@ -549,14 +550,29 @@ int eip93_send_req(struct crypto_async_request *async,
 	rctx->sa_state_ctr = NULL;
 	rctx->sa_state = NULL;
 
+	err = check_valid_request(rctx);
+	if (err)
+		goto free_sg_copy;
+	src = rctx->sg_src;
+	dst = rctx->sg_dst;
+
+	rctx->sa_record_base = dma_map_single(eip93->dev, ctx->sa_record,
+					      sizeof(*ctx->sa_record), DMA_TO_DEVICE);
+	if (dma_mapping_error(eip93->dev, rctx->sa_record_base)) {
+		err = -ENOMEM;
+		goto free_sg_copy;
+	}
+
 	if (IS_ECB(flags))
 		goto skip_iv;
 
 	memcpy(iv, reqiv, rctx->ivsize);
 
 	rctx->sa_state = kzalloc(sizeof(*rctx->sa_state), GFP_KERNEL);
-	if (!rctx->sa_state)
-		return -ENOMEM;
+	if (!rctx->sa_state) {
+		err = -ENOMEM;
+		goto unmap_sa_record;
+	}
 
 	sa_state = rctx->sa_state;
 
@@ -595,17 +611,19 @@ int eip93_send_req(struct crypto_async_request *async,
 			rctx->sa_state_ctr_base = dma_map_single(eip93->dev, rctx->sa_state_ctr,
 								 sizeof(*rctx->sa_state_ctr),
 								 DMA_TO_DEVICE);
-			err = dma_mapping_error(eip93->dev, rctx->sa_state_ctr_base);
-			if (err)
+			if (dma_mapping_error(eip93->dev, rctx->sa_state_ctr_base)) {
+				err = -ENOMEM;
 				goto free_sa_state_ctr;
+			}
 		}
 	}
 
 	rctx->sa_state_base = dma_map_single(eip93->dev, rctx->sa_state,
 					     sizeof(*rctx->sa_state), DMA_TO_DEVICE);
-	err = dma_mapping_error(eip93->dev, rctx->sa_state_base);
-	if (err)
-		goto free_sa_state_ctr_dma;
+	if (dma_mapping_error(eip93->dev, rctx->sa_state_base)) {
+		err = -ENOMEM;
+		goto unmap_sa_state_ctr;
+	}
 
 skip_iv:
 
@@ -624,32 +642,40 @@ skip_iv:
 	 */
 	if (!dma_map_sg(eip93->dev, dst, rctx->dst_nents, DMA_BIDIRECTIONAL)) {
 		err = -ENOMEM;
-		goto free_sa_state_ctr_dma;
+		goto unmap_sa_state;
 	}
 
 	if (src != dst &&
 	    !dma_map_sg(eip93->dev, src, rctx->src_nents, DMA_TO_DEVICE)) {
 		err = -ENOMEM;
-		goto free_sg_dma;
+		goto unmap_sg_dst;
 	}
 
 	return eip93_scatter_combine(eip93, rctx, datalen, split, offsetin);
 
-free_sg_dma:
+unmap_sg_dst:
 	dma_unmap_sg(eip93->dev, dst, rctx->dst_nents, DMA_BIDIRECTIONAL);
-free_sa_state_ctr_dma:
+unmap_sa_state:
+	if (rctx->sa_state)
+		dma_unmap_single(eip93->dev, rctx->sa_state_base,
+				 sizeof(*rctx->sa_state), DMA_TO_DEVICE);
+unmap_sa_state_ctr:
 	if (rctx->sa_state_ctr)
 		dma_unmap_single(eip93->dev, rctx->sa_state_ctr_base,
-				 sizeof(*rctx->sa_state_ctr),
-				 DMA_TO_DEVICE);
+				 sizeof(*rctx->sa_state_ctr), DMA_TO_DEVICE);
 free_sa_state_ctr:
 	kfree(rctx->sa_state_ctr);
-	if (rctx->sa_state)
-		dma_unmap_single(eip93->dev, rctx->sa_state_base,
-				 sizeof(*rctx->sa_state),
-				 DMA_TO_DEVICE);
 free_sa_state:
 	kfree(rctx->sa_state);
+unmap_sa_record:
+	dma_unmap_single(eip93->dev, rctx->sa_record_base,
+			 sizeof(*ctx->sa_record), DMA_TO_DEVICE);
+free_sg_copy:
+	/* No descriptor was submitted: discard bounce buffers without copyback. */
+	if (rctx->sg_src != reqsrc)
+		eip93_free_sg_copy(datalen + rctx->authsize, &rctx->sg_src);
+	if (rctx->sg_dst != reqdst)
+		eip93_free_sg_copy(datalen + rctx->authsize, &rctx->sg_dst);
 
 	return err;
 }
@@ -701,6 +727,9 @@ process_tag:
 void eip93_handle_result(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx,
 			 u8 *reqiv)
 {
+	dma_unmap_single(eip93->dev, rctx->sa_record_base,
+			 sizeof(struct sa_record), DMA_TO_DEVICE);
+
 	if (rctx->sa_state_ctr)
 		dma_unmap_single(eip93->dev, rctx->sa_state_ctr_base,
 				 sizeof(*rctx->sa_state_ctr),
