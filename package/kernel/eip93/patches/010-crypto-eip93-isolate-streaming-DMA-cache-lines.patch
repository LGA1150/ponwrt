From 26985d1d4afa75421b06e48aae9eecdabfa8d21e Mon Sep 17 00:00:00 2001
From: LGA1150 <9155358+LGA1150@users.noreply.github.com>
Date: Tue, 17 Nov 2026 11:45:27 +0800
Subject: [PATCH] crypto: eip93 - isolate DMA-written cache lines

Checking word-aligned addresses and cipher-block lengths is insufficient
for buffers written by a non-coherent device. CPU writes to a neighboring
range can dirty a shared cache line and overwrite DMA output when it is
cleaned. kTLS can pack records into adjacent page fragments.

DMA_BOUNCE_UNALIGNED_KMALLOC protects small destination mappings, including
the generic GCM mask block. It does not check pointer alignment and skips
mappings at least twice ARCH_DMA_MINALIGN in size. A page-sized SG entry
at a partial cache-line offset can therefore still be mapped directly.

Require cache-aligned offsets and complete SG-entry lengths for
DMA-written destinations and in-place buffers. Read-only DMA_TO_DEVICE
sources retain the existing hardware checks: cache cleaning is
non-destructive for them. Check the entire mapped destination entry even
when cryptlen ends before its end. Use the existing bounce path otherwise,
and round its private mapping up to a cache-line boundary without changing
the number of bytes encrypted or copied back.

This fixes an unsafe destination mapping accepted by the driver. It is a
candidate for the intermittent TLS 1.2 plaintext mismatch seen on AN7581;
device validation is still needed to establish the reported failure's
cause.

Signed-off-by: LGA1150 <9155358+LGA1150@users.noreply.github.com>
---
 eip93-common.c | 26 ++++++++++++++++++++------
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/eip93-common.c b/eip93-common.c
index d23e2cf..07c490d 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -196,7 +196,8 @@ static int eip93_make_sg_copy(struct scatterlist *src, struct scatterlist **dst,
 	}
 
 	sg_init_table(*dst, 1);
-	sg_set_buf(*dst, pages, len);
+	/* The page allocation owns the padding through the last cache line. */
+	sg_set_buf(*dst, pages, ALIGN(len, dma_get_cache_alignment()));
 
 	/* copy only as requested */
 	if (copy)
@@ -206,14 +207,25 @@ static int eip93_make_sg_copy(struct scatterlist *src, struct scatterlist **dst,
 }
 
 static bool eip93_is_sg_aligned(struct scatterlist *sg, u32 len,
-				const int blksize)
+				const int blksize, bool dma_write)
 {
+	unsigned int dma_align = dma_get_cache_alignment();
 	int nents;
 
 	for (nents = 0; sg; sg = sg_next(sg), ++nents) {
 		if (!IS_ALIGNED(sg->offset, 4))
 			return false;
 
+		/*
+		 * DMA-written buffers must not share cache lines with CPU writes.
+		 * Read-only sources only need the hardware alignment checks.
+		 * dma_map_sg() maps the entire entry, including any bytes beyond
+		 * the requested crypt length in the last entry.
+		 */
+		if (dma_write && (!IS_ALIGNED(sg->offset, dma_align) ||
+				  !IS_ALIGNED(sg->length, dma_align)))
+			return false;
+
 		if (len <= sg->length) {
 			if (!IS_ALIGNED(len, blksize))
 				return false;
@@ -279,21 +291,23 @@ static int check_valid_request(struct eip93_cipher_reqctx *rctx)
 
 	if (authsize) {
 		if (dst_nents == 1 && src_nents == 1) {
-			src_align = eip93_is_sg_aligned(src, totlen_src, blksize);
+			src_align = eip93_is_sg_aligned(src, totlen_src, blksize,
+							src == dst);
 			if (src ==  dst)
 				dst_align = src_align;
 			else
-				dst_align = eip93_is_sg_aligned(dst, totlen_dst, blksize);
+				dst_align = eip93_is_sg_aligned(dst, totlen_dst,
+								blksize, true);
 		} else {
 			src_align = false;
 			dst_align = false;
 		}
 	} else {
-		src_align = eip93_is_sg_aligned(src, totlen_src, blksize);
+		src_align = eip93_is_sg_aligned(src, totlen_src, blksize, src == dst);
 		if (src == dst)
 			dst_align = src_align;
 		else
-			dst_align = eip93_is_sg_aligned(dst, totlen_dst, blksize);
+			dst_align = eip93_is_sg_aligned(dst, totlen_dst, blksize, true);
 	}
 
 	copy_len = max(totlen_src, totlen_dst);
