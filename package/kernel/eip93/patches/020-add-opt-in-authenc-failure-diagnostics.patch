From 25ba0ce326f879bee21c1b48474be7a639c0548f Mon Sep 17 00:00:00 2001
From: Qingfang Deng <dqfext@gmail.com>
Date: Tue, 17 Nov 2026 19:01:29 +0800
Subject: [PATCH] crypto: eip93 - add opt-in authenc failure diagnostics

The direct tests intermittently reject valid SHA256/RFC3686 ciphertext
or report an encryption output mismatch in case 281. Isolated replay can
also fail, so the case parameters and error code do not identify a root
cause. Both data buffers already use separate aligned bounce allocations.

Add a root-writable aead_debug parameter, disabled by default. For native
AEAD failures, report the raw result control and length words along with
the hardware and final error codes. For host tag verification failures,
also report request dimensions, flags,
bounce-buffer use and a bit mask of differing tag bytes. This separates
a hardware error from a computed-digest mismatch without logging packet,
key or tag values. Expected authentication-negative tests also log their
failures while diagnostics are enabled.

The crypto and DMA paths are unchanged. This is instrumentation, not a
fix for the reported intermittent failure. Host GCC 14.2 W=1 builds the
complete module. In a QEMU software model, fault injection verifies the
mismatch mask after SHA word conversion, while a normal case passes its
valid and authentication-negative operations. Physical DMA is not modeled.

Signed-off-by: Qingfang Deng <dqfext@gmail.com>
---
 eip93-aead.c   |  9 ++++++++-
 eip93-aead.h   |  3 ++-
 eip93-common.c | 21 ++++++++++++++++++++-
 eip93-common.h |  2 ++
 eip93-main.c   |  2 +-
 5 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/eip93-aead.c b/eip93-aead.c
index 59f3a87..1aa7a5e 100644
--- a/eip93-aead.c
+++ b/eip93-aead.c
@@ -27,14 +27,21 @@
 #include "eip93-common.h"
 #include "eip93-regs.h"
 
-void eip93_aead_handle_result(struct crypto_async_request *async, int err)
+void eip93_aead_handle_result(struct crypto_async_request *async, int err,
+			      u32 ctrl, u32 length)
 {
 	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(async->tfm);
 	struct eip93_device *eip93 = ctx->eip93;
 	struct aead_request *req = aead_request_cast(async);
 	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
+	int hw_err = err;
 
 	err = eip93_unmap_dma(eip93, rctx, req->src, req->dst, err);
+	if (err && READ_ONCE(eip93_aead_debug))
+		dev_info(eip93->dev,
+			 "authenc %s error: id=%d ctrl=%#x len=%#x hw_err=%d err=%d\n",
+			 hw_err ? "hardware" : "verification", rctx->request_id,
+			 ctrl, length, hw_err, err);
 	eip93_handle_result(eip93, rctx, req->iv);
 
 	aead_request_complete(req, err);
diff --git a/eip93-aead.h b/eip93-aead.h
index c2fae65..6142ab5 100644
--- a/eip93-aead.h
+++ b/eip93-aead.h
@@ -35,6 +35,7 @@ extern struct eip93_alg_template eip93_alg_authenc_hmac_sha256_ecb_null;
 
 int eip93_aead_submit(struct crypto_async_request *async);
 
-void eip93_aead_handle_result(struct crypto_async_request *async, int err);
+void eip93_aead_handle_result(struct crypto_async_request *async, int err,
+			      u32 ctrl, u32 length);
 
 #endif /* _EIP93_AEAD_H_ */
diff --git a/eip93-common.c b/eip93-common.c
index c6fd249..6cc4749 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -14,6 +14,7 @@
 #include <crypto/sha2.h>
 #include <linux/kernel.h>
 #include <linux/dma-mapping.h>
+#include <linux/moduleparam.h>
 #include <linux/scatterlist.h>
 #include <linux/unaligned.h>
 
@@ -23,6 +24,10 @@
 #include "eip93-main.h"
 #include "eip93-regs.h"
 
+bool eip93_aead_debug;
+module_param_named(aead_debug, eip93_aead_debug, bool, 0600);
+MODULE_PARM_DESC(aead_debug, "Log authenc completion status and tag mismatch byte masks");
+
 int eip93_alloc_req_id(struct eip93_device *eip93,
 		       struct crypto_async_request *async)
 {
@@ -751,8 +756,22 @@ process_tag:
 		}
 		/* The separate output buffer preserves the tag even in-place. */
 		if (IS_DECRYPT(flags) &&
-		    crypto_memneq(sg_virt(rctx->sg_src) + len, otag, authsize))
+		    crypto_memneq(sg_virt(rctx->sg_src) + len, otag, authsize)) {
 			err = -EBADMSG;
+			if (READ_ONCE(eip93_aead_debug)) {
+				const u8 *itag = sg_virt(rctx->sg_src) + len;
+				u32 different = 0;
+
+				for (i = 0; i < authsize; i++)
+					if (itag[i] != otag[i])
+						different |= BIT(i);
+				dev_info(eip93->dev,
+					 "authenc tag mismatch: id=%d flags=%#x text=%u aad=%u tag=%u different=%08x src_copy=%d dst_copy=%d\n",
+					 rctx->request_id, flags, rctx->textsize,
+					 rctx->assoclen, authsize, different,
+					 rctx->sg_src != reqsrc, rctx->sg_dst != reqdst);
+			}
+		}
 	}
 
 	if (rctx->sg_src != rctx->sg_dst && rctx->sg_src != reqsrc)
diff --git a/eip93-common.h b/eip93-common.h
index 400a6f2..0da4726 100644
--- a/eip93-common.h
+++ b/eip93-common.h
@@ -9,6 +9,8 @@
 #ifndef _EIP93_COMMON_H_
 #define _EIP93_COMMON_H_
 
+extern bool eip93_aead_debug;
+
 int eip93_alloc_req_id(struct eip93_device *eip93,
 		       struct crypto_async_request *async);
 struct crypto_async_request *eip93_take_req(struct eip93_device *eip93, int id);
diff --git a/eip93-main.c b/eip93-main.c
index 4707ff3..a46ce8a 100644
--- a/eip93-main.c
+++ b/eip93-main.c
@@ -257,7 +257,7 @@ get_more:
 		eip93_skcipher_handle_result(async, err);
 
 	if (desc_flags & EIP93_DESC_AEAD)
-		eip93_aead_handle_result(async, err);
+		eip93_aead_handle_result(async, err, pe_ctrl_stat, pe_length);
 
 	if (desc_flags & EIP93_DESC_HASH)
 		eip93_hash_handle_result(async, err);
-- 
2.52.0

