From e46457389f25c687ada2c51a2951836416a93ec7 Mon Sep 17 00:00:00 2001
From: Qingfang Deng <dqfext@gmail.com>
Date: Tue, 17 Nov 2026 10:15:45 +0800
Subject: [PATCH] crypto: eip93 - publish hash DMA bookkeeping before
 submission

Store the data DMA mapping before publishing its descriptor. A fast
completion may otherwise unmap an uninitialized address or free the
request before the submitting CPU stores the mapping.

Signed-off-by: Qingfang Deng <dqfext@gmail.com>
---
 eip93-hash.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/eip93-hash.c b/eip93-hash.c
index aaa1f12..772f0a7 100644
--- a/eip93-hash.c
+++ b/eip93-hash.c
@@ -261,6 +261,9 @@ static int eip93_send_hash_req(struct crypto_async_request *async, u8 *data,
 				 FIELD_PREP(EIP93_PE_USER_ID_DESC_FLAGS, EIP93_DESC_LAST);
 	}
 
+	/* Completion may run as soon as the descriptor becomes visible. */
+	*data_dma = src_addr;
+
 again:
 	scoped_guard(spinlock_irqsave, &eip93->ring->write_lock)
 		ret = eip93_put_descriptor(eip93, &cdesc);
@@ -273,7 +276,6 @@ again:
 	/* Writing new descriptor count starts DMA action */
 	writel(1, eip93->base + EIP93_REG_PE_CD_COUNT);
 
-	*data_dma = src_addr;
 	return 0;
 }
 
