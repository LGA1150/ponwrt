From ada7a8a186f9919b6828e174e9454379db6c4d32 Mon Sep 17 00:00:00 2001
From: LGA1150 <9155358+LGA1150@users.noreply.github.com>
Date: Tue, 17 Nov 2026 17:51:56 +0800
Subject: [PATCH] crypto: eip93 - preserve authenc associated-data byte offsets

The SA hash/crypt offset currently divides assoclen by four, rounding
non-word-aligned AAD down and truncating large offsets in the eight-bit
field. This moves the start of the cipher payload and produces invalid
authenc output independently of tag verification.

Use word offsets for aligned AAD up to 1020 bytes and the documented byte
offset mode for unaligned lengths from 4 through 255. Reuse the synchronous
authenc fallback for other lengths, including one- and three-byte AAD,
rather than programming an unsupported or truncated offset. The SHARC+
hardware reference, table 44-69, specifies these ranges when the IV comes
from the SA state. Preserve the existing empty-payload fallback.

Host GCC 14.2 W=1 builds the complete module. A QEMU software model using
the actual SA setup detects the old case 57 offset of 12 for 13-byte AAD.
With this fix and the preceding tag verification fix, the existing test
module passes all 12,824 authenc cases across sixteen algorithms. A private
copy with AAD lengths around 255/256 and 1020/1024 passes another 6,488
cases. The fixture runs the actual AEAD front ends, SG preparation and
completion code, but synchronous software models crypto and DMA is stubbed.
Device validation of byte-offset mode remains necessary.

Signed-off-by: LGA1150 <9155358+LGA1150@users.noreply.github.com>
---
 eip93-aead.c   | 20 ++++++++++++++++++--
 eip93-common.c | 11 ++++++++---
 2 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/eip93-aead.c b/eip93-aead.c
index aa281b5..59f3a87 100644
--- a/eip93-aead.c
+++ b/eip93-aead.c
@@ -226,12 +226,27 @@ static int eip93_aead_fallback(struct aead_request *req, bool encrypt)
 	return encrypt ? crypto_aead_encrypt(subreq) : crypto_aead_decrypt(subreq);
 }
 
+static bool eip93_aead_needs_fallback(struct aead_request *req,
+				      unsigned int textsize)
+{
+	unsigned int max_offset = FIELD_MAX(EIP93_SA_CMD_HASH_CRYPT_OFFSET);
+
+	if (!textsize)
+		return true;
+
+	if (IS_ALIGNED(req->assoclen, sizeof(u32)))
+		return req->assoclen / sizeof(u32) > max_offset;
+
+	/* Byte offsets are only defined from 4 through 255 with an SA IV. */
+	return req->assoclen < sizeof(u32) || req->assoclen > max_offset;
+}
+
 static int eip93_aead_encrypt(struct aead_request *req)
 {
 	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
 	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
 
-	if (!req->cryptlen)
+	if (eip93_aead_needs_fallback(req, req->cryptlen))
 		return eip93_aead_fallback(req, true);
 
 	rctx->flags = ctx->flags;
@@ -245,7 +260,8 @@ static int eip93_aead_decrypt(struct aead_request *req)
 	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(req->base.tfm);
 	struct eip93_cipher_reqctx *rctx = aead_request_ctx(req);
 
-	if (req->cryptlen == crypto_aead_authsize(crypto_aead_reqtfm(req)))
+	if (eip93_aead_needs_fallback(req, req->cryptlen -
+				    crypto_aead_authsize(crypto_aead_reqtfm(req))))
 		return eip93_aead_fallback(req, false);
 
 	rctx->flags = ctx->flags;
diff --git a/eip93-common.c b/eip93-common.c
index b7f9998..c6fd249 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -556,6 +556,7 @@ int eip93_send_req(struct crypto_async_request *async,
 	struct sa_state *sa_state;
 	struct eip93_descriptor cdesc;
 	u32 flags = rctx->flags;
+	u32 assoclen = rctx->assoclen;
 	int offsetin = 0, err;
 	u32 datalen = rctx->assoclen + rctx->textsize;
 	u32 split = datalen;
@@ -580,10 +581,14 @@ int eip93_send_req(struct crypto_async_request *async,
 	if (IS_DECRYPT(flags))
 		rctx->sa_record->sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
 	if (IS_HMAC(flags)) {
-		rctx->sa_record->sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
+		rctx->sa_record->sa_cmd1_word &= ~(EIP93_SA_CMD_HASH_CRYPT_OFFSET |
+						 EIP93_SA_CMD_BYTE_OFFSET);
+		if (IS_ALIGNED(assoclen, sizeof(u32)))
+			assoclen /= sizeof(u32);
+		else
+			rctx->sa_record->sa_cmd1_word |= EIP93_SA_CMD_BYTE_OFFSET;
 		rctx->sa_record->sa_cmd1_word |=
-			FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
-				   rctx->assoclen / sizeof(u32));
+			FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET, assoclen);
 		if (IS_DECRYPT(flags))
 			rctx->sa_record->sa_cmd1_word &= ~EIP93_SA_CMD_COPY_PAD;
 	}
-- 
2.52.0

