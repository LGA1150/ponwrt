From bc0cd4747517de5111e872bdafdb4754cfd36a73 Mon Sep 17 00:00:00 2001
From: LGA1150 <9155358+LGA1150@users.noreply.github.com>
Date: Tue, 17 Nov 2026 10:42:35 +0800
Subject: [PATCH] crypto: eip93 - diagnose unmatched completion IDs

Log the completion ID, flags and status before skipping an unmatched
request instead of dereferencing NULL in tasklet context.

This guard cannot recover the unknown request or complete its caller.
The diagnostic is needed to distinguish failed ID allocation from a
stale or corrupted completion during testing.

Signed-off-by: LGA1150 <9155358+LGA1150@users.noreply.github.com>
---
 eip93-main.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/eip93-main.c b/eip93-main.c
index 59b19e6..9e99a5a 100644
--- a/eip93-main.c
+++ b/eip93-main.c
@@ -249,9 +249,13 @@ get_more:
 		goto get_more;
 
 	/* Get crypto async ref only for last descriptor */
-	scoped_guard(spinlock_bh, &eip93->ring->idr_lock) {
-		async = idr_find(&eip93->ring->crypto_async_idr, crypto_idr);
-		idr_remove(&eip93->ring->crypto_async_idr, crypto_idr);
+	scoped_guard(spinlock_bh, &eip93->ring->idr_lock)
+		async = idr_remove(&eip93->ring->crypto_async_idr, crypto_idr);
+	if (!async) {
+		dev_err_ratelimited(eip93->dev,
+				    "Missing request: id=%#x flags=%#x ctrl=%#x len=%#x\n",
+				    crypto_idr, desc_flags, pe_ctrl_stat, pe_length);
+		goto get_more;
 	}
 
 	/* Parse error in ctrl stat word */
