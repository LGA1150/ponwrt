From 7a4eed41df702dc260e0147f385b9a2ef1a1da20 Mon Sep 17 00:00:00 2001
From: Qingfang Deng <dqfext@gmail.com>
Date: Tue, 17 Nov 2026 10:15:36 +0800
Subject: [PATCH] crypto: eip93 - honor cipher request allocation flags

Use GFP_ATOMIC when the caller has not set CRYPTO_TFM_REQ_MAY_SLEEP.
Apply the request's allocation flags to bounce buffers and IV state so
allocation failure follows the normal preparation unwind.

Signed-off-by: Qingfang Deng <dqfext@gmail.com>
---
 eip93-common.c | 21 +++++++++++----------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/eip93-common.c b/eip93-common.c
index d91dbeb..24cd435 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -148,16 +148,15 @@ static void eip93_free_sg_copy(const int len, struct scatterlist **sg)
 }
 
 static int eip93_make_sg_copy(struct scatterlist *src, struct scatterlist **dst,
-			      const u32 len, const bool copy)
+			      const u32 len, const bool copy, gfp_t gfp)
 {
 	void *pages;
 
-	*dst = kmalloc(sizeof(**dst), GFP_KERNEL);
+	*dst = kmalloc(sizeof(**dst), gfp);
 	if (!*dst)
 		return -ENOMEM;
 
-	pages = (void *)__get_free_pages(GFP_KERNEL | GFP_DMA,
-					 get_order(len));
+	pages = (void *)__get_free_pages(gfp | GFP_DMA, get_order(len));
 	if (!pages) {
 		kfree(*dst);
 		*dst = NULL;
@@ -198,7 +197,7 @@ static bool eip93_is_sg_aligned(struct scatterlist *sg, u32 len,
 	return false;
 }
 
-static int check_valid_request(struct eip93_cipher_reqctx *rctx)
+static int check_valid_request(struct eip93_cipher_reqctx *rctx, gfp_t gfp)
 {
 	struct scatterlist *src = rctx->sg_src;
 	struct scatterlist *dst = rctx->sg_dst;
@@ -267,13 +266,13 @@ static int check_valid_request(struct eip93_cipher_reqctx *rctx)
 
 	copy_len = max(totlen_src, totlen_dst);
 	if (!src_align) {
-		err = eip93_make_sg_copy(src, &rctx->sg_src, copy_len, true);
+		err = eip93_make_sg_copy(src, &rctx->sg_src, copy_len, true, gfp);
 		if (err)
 			return err;
 	}
 
 	if (!dst_align) {
-		err = eip93_make_sg_copy(dst, &rctx->sg_dst, copy_len, false);
+		err = eip93_make_sg_copy(dst, &rctx->sg_dst, copy_len, false, gfp);
 		if (err)
 			return err;
 	}
@@ -518,6 +517,8 @@ int eip93_send_req(struct crypto_async_request *async,
 	struct scatterlist *reqsrc = src, *reqdst = dst;
 	struct sa_state *sa_state;
 	struct eip93_descriptor cdesc;
+	gfp_t gfp = async->flags & CRYPTO_TFM_REQ_MAY_SLEEP ?
+		    GFP_KERNEL : GFP_ATOMIC;
 	u32 flags = rctx->flags;
 	int offsetin = 0, err;
 	u32 datalen = rctx->assoclen + rctx->textsize;
@@ -529,7 +530,7 @@ int eip93_send_req(struct crypto_async_request *async,
 	rctx->sa_state_ctr = NULL;
 	rctx->sa_state = NULL;
 
-	err = check_valid_request(rctx);
+	err = check_valid_request(rctx, gfp);
 	if (err)
 		goto free_sg_copy;
 	src = rctx->sg_src;
@@ -547,7 +548,7 @@ int eip93_send_req(struct crypto_async_request *async,
 
 	memcpy(iv, reqiv, rctx->ivsize);
 
-	rctx->sa_state = kzalloc(sizeof(*rctx->sa_state), GFP_KERNEL);
+	rctx->sa_state = kzalloc(sizeof(*rctx->sa_state), gfp);
 	if (!rctx->sa_state) {
 		err = -ENOMEM;
 		goto unmap_sa_record;
@@ -578,7 +579,7 @@ int eip93_send_req(struct crypto_async_request *async,
 			crypto_inc((u8 *)iv, AES_BLOCK_SIZE);
 
 			rctx->sa_state_ctr = kzalloc(sizeof(*rctx->sa_state_ctr),
-						     GFP_KERNEL);
+						     gfp);
 			if (!rctx->sa_state_ctr) {
 				err = -ENOMEM;
 				goto free_sa_state;
