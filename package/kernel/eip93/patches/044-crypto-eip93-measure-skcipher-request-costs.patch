--- a/Makefile
+++ b/Makefile
@@ -3,3 +3,4 @@ obj-$(CONFIG_CRYPTO_DEV_EIP93) += crypto-hw-eip93.o
 crypto-hw-eip93-y += eip93-main.o eip93-common.o eip93-queue.o
 crypto-hw-eip93-y += eip93-cipher.o eip93-aead.o
 crypto-hw-eip93-y += eip93-hash.o
+crypto-hw-eip93-y += eip93-profile.o
diff --git a/eip93-cipher.c b/eip93-cipher.c
index d463dfb..7e3b5aa 100644
--- a/eip93-cipher.c
+++ b/eip93-cipher.c
@@ -33,8 +33,11 @@ void eip93_skcipher_handle_result(struct crypto_async_request *async, int err)
 	if (rctx->ctr_sg) {
 		err = eip93_complete_ctr_sg(eip93, req, err);
 	} else {
+		eip93_profile_complete(&rctx->profile);
 		err = eip93_unmap_dma(eip93, rctx, req->src, req->dst, err);
 		eip93_handle_result(eip93, rctx, req->iv);
+		eip93_profile_stage(&rctx->profile, EIP93_P_COMPLETE_NS);
+		eip93_profile_finish(&rctx->profile, err);
 	}
 
 	skcipher_request_complete(req, err);
@@ -207,9 +210,13 @@ int eip93_skcipher_submit(struct crypto_async_request *async)
 	int ret, request_id;
 
 	/* Reserve completion tracking before any DMA or bounce preparation. */
+	eip93_profile_start(&rctx->profile, req->cryptlen, IS_DECRYPT(rctx->flags));
 	request_id = eip93_alloc_req_id(eip93, async);
-	if (request_id < 0)
+	eip93_profile_stage(&rctx->profile, EIP93_P_ID_NS);
+	if (request_id < 0) {
+		eip93_profile_finish(&rctx->profile, request_id);
 		return request_id;
+	}
 	rctx->request_id = request_id;
 
 	rctx->assoclen = 0;
@@ -226,6 +233,10 @@ int eip93_skcipher_submit(struct crypto_async_request *async)
 		return ret;
 
 	eip93_free_req_id(eip93, request_id);
+	/* An all-software CTR request has already recorded its completion. */
+	eip93_profile_stage(&rctx->profile, rctx->profile.prepared ?
+			    EIP93_P_SUBMIT_NS : EIP93_P_PREPARE_NS);
+	eip93_profile_finish(&rctx->profile, ret);
 	return ret;
 }
 
diff --git a/eip93-cipher.h b/eip93-cipher.h
