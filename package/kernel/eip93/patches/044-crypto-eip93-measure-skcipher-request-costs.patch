new file mode 100644
index 0000000..b56e50e
--- /dev/null
+++ b/eip93-profile.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _EIP93_PROFILE_H_
+#define _EIP93_PROFILE_H_
+
+#include <linux/ktime.h>
+
+enum eip93_profile_field {
+	EIP93_P_REQUESTS,
+	EIP93_P_ERRORS,
+	EIP93_P_BYTES,
+	EIP93_P_SRC_NENTS,
+	EIP93_P_DESCRIPTORS,
+	EIP93_P_HW_BYTES,
+	EIP93_P_SW_BYTES,
+	EIP93_P_SRC_COPIES,
+	EIP93_P_DST_COPIES,
+	EIP93_P_ID_NS,
+	EIP93_P_PREPARE_NS,
+	EIP93_P_PLAN_NS,
+	EIP93_P_MAP_NS,
+	EIP93_P_SUBMIT_NS,
+	EIP93_P_PENDING_NS,
+	EIP93_P_COMPLETE_NS,
+	EIP93_P_COPY_NS,
+	EIP93_P_FIELDS,
+};
+
+struct eip93_profile {
+	u64 value[EIP93_P_FIELDS];
+	u64 stamp;
+	u64 generation;
+	u8 bucket;
+	bool active;
+	bool prepared;
+};
+
+void eip93_profile_start(struct eip93_profile *p, u32 bytes, bool decrypt);
+void eip93_profile_finish(struct eip93_profile *p, int err);
+
+static inline u64 eip93_profile_time(const struct eip93_profile *p)
+{
+	return p && p->active ? ktime_get_ns() : 0;
+}
+
+static inline void eip93_profile_add(struct eip93_profile *p,
+				     enum eip93_profile_field field, u64 start)
+{
+	if (p && p->active)
+		p->value[field] += ktime_get_ns() - start;
+}
+
+static inline void eip93_profile_stage(struct eip93_profile *p,
+				       enum eip93_profile_field field)
+{
+	u64 now = eip93_profile_time(p);
+
+	if (p && p->active) {
+		p->value[field] += now - p->stamp;
+		p->stamp = now;
+	}
+}
+
+static inline void eip93_profile_prepared(struct eip93_profile *p,
+					  bool src_copy, bool dst_copy)
+{
+	if (!p || !p->active)
+		return;
+	p->value[EIP93_P_SRC_COPIES] = src_copy;
+	p->value[EIP93_P_DST_COPIES] = dst_copy;
+	eip93_profile_stage(p, EIP93_P_PREPARE_NS);
+	p->prepared = true;
+}
+
+/* Called before the doorbell: the last descriptor may free the request. */
+static inline void eip93_profile_descriptor(struct eip93_profile *p,
+					    u32 bytes, bool last)
+{
+	if (!p || !p->active)
+		return;
+	p->value[EIP93_P_DESCRIPTORS]++;
+	p->value[EIP93_P_HW_BYTES] += bytes;
+	if (last)
+		eip93_profile_stage(p, EIP93_P_SUBMIT_NS);
+}
+
+static inline void eip93_profile_complete(struct eip93_profile *p)
+{
+	if (!p || !p->active)
+		return;
+	if (p->value[EIP93_P_DESCRIPTORS])
+		eip93_profile_stage(p, EIP93_P_PENDING_NS);
+	else
+		p->stamp = ktime_get_ns();
+}
+
+#endif /* _EIP93_PROFILE_H_ */
