diff --git a/eip93-profile.c b/eip93-profile.c
new file mode 100644
index 0000000..254c331
--- /dev/null
+++ b/eip93-profile.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Optional aggregate skcipher measurements; no per-request logging. */
+#include <linux/moduleparam.h>
+#include <linux/spinlock.h>
+#include <linux/sysfs.h>
+
+#include "eip93-profile.h"
+
+static bool skcipher_profile;
+module_param(skcipher_profile, bool, 0600);
+MODULE_PARM_DESC(skcipher_profile, "Collect skcipher counts and elapsed stage times (default off)");
+
+static unsigned int skcipher_profile_min_bytes = 1024;
+module_param(skcipher_profile_min_bytes, uint, 0600);
+MODULE_PARM_DESC(skcipher_profile_min_bytes, "Minimum logical request size to profile (default 1024)");
+
+static DEFINE_SPINLOCK(profile_lock);
+static u64 profile_generation = 1;
+static u64 profile_totals[4][EIP93_P_FIELDS];
+
+static int eip93_profile_get(char *buf, const struct kernel_param *kp)
+{
+	static const char * const names[] = {
+		"requests", "errors", "bytes", "src_nents", "descriptors",
+		"hw_bytes", "sw_bytes", "src_copies", "dst_copies", "id_ns",
+		"prepare_ns", "plan_ns", "map_ns", "submit_ns", "pending_ns",
+		"complete_ns", "copy_ns",
+	};
+	u64 snapshot[4][EIP93_P_FIELDS], generation;
+	unsigned long flags;
+	int i, j, len;
+
+	static_assert(ARRAY_SIZE(names) == EIP93_P_FIELDS);
+	spin_lock_irqsave(&profile_lock, flags);
+	memcpy(snapshot, profile_totals, sizeof(snapshot));
+	generation = profile_generation;
+	spin_unlock_irqrestore(&profile_lock, flags);
+
+	len = sysfs_emit(buf, "generation=%llu enabled=%u min_bytes=%u\n",
+			 generation, READ_ONCE(skcipher_profile),
+			 READ_ONCE(skcipher_profile_min_bytes));
+	len += sysfs_emit_at(buf, len, "path,direction");
+	for (j = 0; j < EIP93_P_FIELDS; j++)
+		len += sysfs_emit_at(buf, len, ",%s", names[j]);
+	len += sysfs_emit_at(buf, len, "\n");
+	for (i = 0; i < ARRAY_SIZE(snapshot); i++) {
+		len += sysfs_emit_at(buf, len, "%s,%s", i & 2 ? "ctr_sg" : "legacy",
+				     i & 1 ? "decrypt" : "encrypt");
+		for (j = 0; j < EIP93_P_FIELDS; j++)
+			len += sysfs_emit_at(buf, len, ",%llu", snapshot[i][j]);
+		len += sysfs_emit_at(buf, len, "\n");
+	}
+	return len;
+}
+
+static int eip93_profile_reset(const char *val, const struct kernel_param *kp)
+{
+	unsigned long flags;
+	unsigned int reset;
+	int err;
+
+	err = kstrtouint(val, 0, &reset);
+	if (err)
+		return err;
+	if (reset)
+		return -EINVAL;
+
+	spin_lock_irqsave(&profile_lock, flags);
+	profile_generation++;
+	memset(profile_totals, 0, sizeof(profile_totals));
+	spin_unlock_irqrestore(&profile_lock, flags);
+	return 0;
+}
+
+static const struct kernel_param_ops eip93_profile_ops = {
+	.get = eip93_profile_get,
+	.set = eip93_profile_reset,
+};
+module_param_cb(skcipher_profile_stats, &eip93_profile_ops, NULL, 0600);
+MODULE_PARM_DESC(skcipher_profile_stats, "Aggregate skcipher CSV; write 0 to reset, excluding older in-flight samples");
+
+void eip93_profile_start(struct eip93_profile *p, u32 bytes, bool decrypt)
+{
+	unsigned long flags;
+
+	p->active = false;
+	p->prepared = false;
+	if (!READ_ONCE(skcipher_profile) || bytes < READ_ONCE(skcipher_profile_min_bytes))
+		return;
+	memset(p, 0, sizeof(*p));
+	spin_lock_irqsave(&profile_lock, flags);
+	p->generation = profile_generation;
+	spin_unlock_irqrestore(&profile_lock, flags);
+	p->bucket = decrypt;
+	p->value[EIP93_P_BYTES] = bytes;
+	p->active = true;
+	p->stamp = ktime_get_ns();
+}
+
+void eip93_profile_finish(struct eip93_profile *p, int err)
+{
+	unsigned long flags;
+	int i;
+
+	if (!p || !p->active)
+		return;
+	p->active = false;
+	p->value[EIP93_P_REQUESTS] = 1;
+	p->value[EIP93_P_ERRORS] = !!err;
+	spin_lock_irqsave(&profile_lock, flags);
+	if (p->generation == profile_generation)
+		for (i = 0; i < EIP93_P_FIELDS; i++)
+			profile_totals[p->bucket][i] += p->value[i];
+	spin_unlock_irqrestore(&profile_lock, flags);
+}
