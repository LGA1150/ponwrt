diff --git a/eip93-common.c b/eip93-common.c
index b25c1fc..4a10325 100644
--- a/eip93-common.c
+++ b/eip93-common.c
@@ -174,8 +174,9 @@ static void eip93_ring_advance(struct eip93_desc_ring *ring, void **ptr)
 		*ptr += ring->offset;
