@@ -1902,11 +2088,20 @@ static int tls_rx_one_record(struct sock *sk, struct msghdr *msg,
 	struct strp_msg *rxm;
 	int err;
 
-	err = tls_decrypt_device(sk, msg, tls_ctx, darg);
-	if (!err)
-		err = tls_decrypt_sw(sk, tls_ctx, msg, darg);
-	if (err < 0)
