From 60b36d461913d8c32653ded2d54378bc7d0b19fd Mon Sep 17 00:00:00 2001
From: LGA1150 <9155358+LGA1150@users.noreply.github.com>
Date: Wed, 25 Nov 2026 16:56:29 +0800
Subject: [PATCH] tls: Decrypt buffered async RX in aligned private pages

Buffered receive currently decrypts retained ciphertext into a separate
plaintext skb. DMA-backed AEAD implementations may then bounce both
sides of the request because the payload fragments do not own whole
cache lines.

Add a private in-place path for buffered receives with asynchronous
AEADs. Reserve headroom before the record so that its encrypted payload,
rather than its wire header, starts at dma_get_cache_alignment(). Keep
subsequent page fragments aligned and copy the record into these private
pages once. Use one input/output scatterlist, including the input tag,
without changing the record length or adding bytes to the cryptographic
operation.

Retain the original ciphertext independently for speculative retries
after KeyUpdate. AEAD implementations may overwrite the working pages
before an authentication error, but must never overwrite shared TCP data
or the retained input. Direct-to-userspace receives, external output
scatterlists and synchronous-only AEADs keep their existing paths.

The default-enabled rx_inplace module parameter allows comparison with
the old out-of-place path. With the EIP93 payload-only GCM
implementation, the aligned bulk CTR extent can be mapped in-place
without either driver bounce; GCM handles the final partial cache line
and tag separately in software.

Extend the existing TLS selftests with four queued records at 21 lengths
around cipher, cache-line and page boundaries, switching from splice to
peek/recv while checking every byte. Existing tests exercise queued
rekeys, authentication failures, shared records, receive pressure and
empty records.

Kernel builds, the external TLS module build with host GCC W=1, and
strict checkpatch pass. Both branches pass 103 focused KASAN selftests;
the 6.18 run repeats its pre-existing padata lock-class warning. An
actual EIP93 GCM wrapper with a software CTR child passes 32 RX
comparisons (in-place on/off, both TLS versions, recv/splice and four
completion modes), four TX trials and six boundary/rekey selftests.
Buffered in-place requests reach the child with shared, whole-cache-line
SGs. Device DMA and throughput still require hardware measurements.

OpenAI Codex assisted with implementation, tests and this changelog in
response to the request to retain one aligned kTLS working copy and
avoid the crypto driver's input and output bounce copies.

(cherry picked from commit 8d33d611ae9d5804d8c1a5c56c60572b293b8d01
 ("tls: Decrypt buffered async RX in aligned private pages"))
---
 net/tls/tls_sw.c | 75 ++++++++++++++++++++++++++++++++++++++----------
 1 file changed, 60 insertions(+), 15 deletions(-)

diff --git a/net/tls/tls_sw.c b/net/tls/tls_sw.c
index f33b710f8682..a5a6249aab9b 100644
--- a/net/tls/tls_sw.c
+++ b/net/tls/tls_sw.c
@@ -36,6 +36,7 @@
  */
 
 #include <linux/bug.h>
+#include <linux/dma-mapping.h>
 #include <linux/sched/signal.h>
 #include <linux/module.h>
 #include <linux/kernel.h>
@@ -51,6 +52,10 @@
 /* Bound speculative ciphertext and plaintext retained by a reader. */
 #define TLS_RX_BATCH_RECORDS	8
 
+static bool rx_inplace = true;
+module_param(rx_inplace, bool, 0644);
+MODULE_PARM_DESC(rx_inplace, "Decrypt buffered async RX records in private aligned buffers");
+
 struct tls_rx_record {
 	struct list_head list;
 	struct sk_buff *skb;
@@ -1590,17 +1595,19 @@ static int tls_setup_from_iter(struct iov_iter *from,
 
 static struct sk_buff *
 tls_alloc_clrtxt_skb(struct sock *sk, struct sk_buff *skb,
-		     unsigned int full_len)
+		     unsigned int full_len, unsigned int headroom)
 {
 	struct strp_msg *clr_rxm;
 	struct sk_buff *clr_skb;
 	int err;
 
-	clr_skb = alloc_skb_with_frags(0, full_len, TLS_PAGE_ORDER,
+	clr_skb = alloc_skb_with_frags(0, full_len + headroom, TLS_PAGE_ORDER,
 				       &err, sk->sk_allocation);
 	if (!clr_skb)
 		return NULL;
 
+	skb_frag_off_add(&skb_shinfo(clr_skb)->frags[0], headroom);
+	skb_frag_size_sub(&skb_shinfo(clr_skb)->frags[0], headroom);
 	skb_copy_header(clr_skb, skb);
 	clr_skb->len = full_len;
 	clr_skb->data_len = full_len;
@@ -1611,6 +1618,23 @@ tls_alloc_clrtxt_skb(struct sock *sk, struct sk_buff *skb,
 	return clr_skb;
 }
 
+static int tls_copy_ciphertext(struct sk_buff *dst, struct sk_buff *src)
+{
+	int offset = strp_msg(src)->offset;
+	int i, err;
+
+	for (i = 0; i < skb_shinfo(dst)->nr_frags; i++) {
+		skb_frag_t *frag = &skb_shinfo(dst)->frags[i];
+
+		err = skb_copy_bits(src, offset, skb_frag_address(frag),
+				    skb_frag_size(frag));
+		if (err)
+			return err;
+		offset += skb_frag_size(frag);
+	}
+	return 0;
+}
+
 /* Decrypt handlers
  *
  * tls_decrypt_sw() and tls_decrypt_device() are decrypt handlers.
@@ -1651,13 +1675,9 @@ static int tls_decrypt_sg(struct sock *sk, struct iov_iter *out_iov,
 	struct sk_buff *clear_skb;
 	char *rec_seq = darg->rec ? darg->rec->rec_seq : tls_ctx->rx.rec_seq;
 	int iv_offset = 0;
+	bool inplace = false;
 	u8 *mem;
 
-	n_sgin = skb_nsg(skb, rxm->offset + prot->prepend_size,
-			 rxm->full_len - prot->prepend_size);
-	if (n_sgin < 1)
-		return n_sgin ?: -EBADMSG;
-
 	if (darg->zc && (out_iov || out_sg)) {
 		clear_skb = NULL;
 
@@ -1667,13 +1687,38 @@ static int tls_decrypt_sg(struct sock *sk, struct iov_iter *out_iov,
 		else
 			n_sgout = sg_nents(out_sg);
 	} else {
+		unsigned int headroom = 0;
+
 		darg->zc = false;
+		inplace = ctx->async_capable && READ_ONCE(rx_inplace);
+		/* Align the payload, leaving the record header immediately before
+		 * it. Subsequent fragments start at page boundaries.
+		 */
+		if (inplace)
+			headroom = ALIGN(prot->prepend_size,
+					 dma_get_cache_alignment()) - prot->prepend_size;
 
-		clear_skb = tls_alloc_clrtxt_skb(sk, skb, rxm->full_len);
+		clear_skb = tls_alloc_clrtxt_skb(sk, skb, rxm->full_len, headroom);
 		if (!clear_skb)
 			return -ENOMEM;
 
-		n_sgout = 1 + skb_shinfo(clear_skb)->nr_frags;
+		if (inplace) {
+			/* Keep the original ciphertext for retries after KeyUpdate.
+			 * Only these private pages may be overwritten by the AEAD.
+			 */
+			err = tls_copy_ciphertext(clear_skb, skb);
+			if (err)
+				goto exit_free_skb;
+		}
+		n_sgout = inplace ? 0 : 1 + skb_shinfo(clear_skb)->nr_frags;
+	}
+
+	n_sgin = inplace ? skb_shinfo(clear_skb)->nr_frags :
+		skb_nsg(skb, rxm->offset + prot->prepend_size,
+			rxm->full_len - prot->prepend_size);
+	if (n_sgin < 1) {
+		err = n_sgin ?: -EBADMSG;
+		goto exit_free_skb;
 	}
 
 	/* Increment to accommodate AAD */
@@ -1701,7 +1746,7 @@ static int tls_decrypt_sg(struct sock *sk, struct iov_iter *out_iov,
 	dctx->offset = darg->offset;
 	dctx->copy_bytes = darg->copy_bytes;
 	sgin = &dctx->sg[0];
-	sgout = &dctx->sg[n_sgin];
+	sgout = inplace ? sgin : &dctx->sg[n_sgin];
 
 	/* For CCM based ciphers, first byte of nonce+iv is a constant */
 	switch (prot->cipher_type) {
@@ -1737,13 +1782,13 @@ static int tls_decrypt_sg(struct sock *sk, struct iov_iter *out_iov,
 	/* Prepare sgin */
 	sg_init_table(sgin, n_sgin);
 	sg_set_buf(&sgin[0], dctx->aad, prot->aad_size);
-	err = skb_to_sgvec(skb, &sgin[1],
-			   rxm->offset + prot->prepend_size,
+	err = skb_to_sgvec(inplace ? clear_skb : skb, &sgin[1],
+			   (inplace ? 0 : rxm->offset) + prot->prepend_size,
 			   rxm->full_len - prot->prepend_size);
 	if (err < 0)
 		goto exit_free;
 
-	if (clear_skb) {
+	if (clear_skb && !inplace) {
 		sg_init_table(sgout, n_sgout);
 		sg_set_buf(&sgout[0], dctx->aad, prot->aad_size);
 
@@ -1751,7 +1796,7 @@ static int tls_decrypt_sg(struct sock *sk, struct iov_iter *out_iov,
 				   data_len + prot->tail_size);
 		if (err < 0)
 			goto exit_free;
-	} else if (out_iov) {
+	} else if (!clear_skb && out_iov) {
 		sg_init_table(sgout, n_sgout);
 		sg_set_buf(&sgout[0], dctx->aad, prot->aad_size);
 
@@ -1766,7 +1811,7 @@ static int tls_decrypt_sg(struct sock *sk, struct iov_iter *out_iov,
 				   prot->tail_size);
 			sg_mark_end(&sgout[pages + 1]);
 		}
-	} else if (out_sg) {
+	} else if (!clear_skb && out_sg) {
 		memcpy(sgout, out_sg, n_sgout * sizeof(*sgout));
 	}
 	dctx->free_sgout = !!pages;
-- 
2.52.0

